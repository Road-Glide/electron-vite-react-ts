{
	"name": "create-electron-vite-react-ts",
	"version": "0.1.4",
	"description": "Create an Electron + Vite + React + TypeScript desktop app.",
	"keywords": [
		"electron",
		"electron-vite",
		"vite",
		"react",
		"typescript",
		"desktop",
		"scaffold",
		"boilerplate",
		"starter",
		"template",
		"create-electron-app",
		"cross-platform",
		"ipc",
		"context-bridge"
	],
	"license": "MIT",
	"type": "module",
	"bin": {
		"create-electron-vite-react-ts": "bin/create-electron-vite-react-ts.js"
	},
	"files": [
		"bin",
		"electron",
		"public",
		"src",
		".editorconfig",
		".env.example",
		"eslint.config.mjs",
		".gitignore",
		".prettierignore",
		".prettierrc",
		"electron.vite.config.ts",
		"tsconfig.app.json",
		"tsconfig.electron.json",
		"tsconfig.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"postinstall": "node ./node_modules/electron/install.js",
		"create:test": "node ./bin/create-electron-vite-react-ts.js ./tmp-create-test",
		"dev": "electron-vite dev",
		"build": "tsc -b && electron-vite build",
		"lint": "eslint .",
		"start": "electron-vite preview",
		"release": "npm run build && electron-builder",
		"format": "prettier --write .",
		"clean": "rimraf dist release node_modules/.cache",
		"lang": "node -e \"if(process.platform==='win32'){require('child_process').spawnSync('chcp',['65001'],{stdio:'inherit',shell:true})}\""
	},
	"dependencies": {
		"electron-vite": "^5.0.0",
		"prettier": "^3.8.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.59.2",
		"@typescript-eslint/parser": "^8.59.2",
		"@vitejs/plugin-react": "^5.2.0",
		"electron": "^42.0.1",
		"electron-builder": "^26.8.1",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"typescript": "^6.0.3",
		"vite": "^7.3.3",
		"vite-plugin-electron": "^0.29.1",
		"vite-plugin-electron-renderer": "^0.14.7"
	},
	"build": {
		"directories": {
			"output": "release"
		}
	},
	"main": "dist/main/main.js"
}
