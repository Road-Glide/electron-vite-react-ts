{
	"name": "create-electron-vite-react-ts",
	"version": "0.1.9",
	"description": "Create an Electron + Vite + React + TypeScript desktop app.",
	"keywords": [
		"electron",
		"electron-vite",
		"vite",
		"react",
		"typescript",
		"desktop",
		"scaffold",
		"boilerplate",
		"starter",
		"template",
		"create-electron-app",
		"cross-platform",
		"ipc",
		"context-bridge"
	],
	"license": "MIT",
	"type": "module",
	"bin": {
		"create-electron-vite-react-ts": "bin/create-electron-vite-react-ts.js"
	},
	"files": [
		"bin",
		"electron",
		"public",
		"src",
		".editorconfig",
		".env.example",
		"eslint.config.mjs",
		".gitignore",
		".prettierignore",
		".prettierrc",
		"electron.vite.config.ts",
		"tsconfig.app.json",
		"tsconfig.electron.json",
		"tsconfig.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "electron-vite dev",
		"build": "tsc -b && electron-vite build",
		"lint": "eslint .",
		"start": "electron-vite preview",
		"release": "npm run build && electron-builder",
		"format": "prettier --write .",
		"clean": "rimraf dist release node_modules/.cache",
		"lang": "node -e \"if(process.platform==='win32'){require('child_process').spawnSync('chcp',['65001'],{stdio:'inherit',shell:true})}\""
	},
	"dependencies": {
		"electron-vite": "^5.0.0",
		"prettier": "^3.8.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"@vitejs/plugin-react": "^4.7.0",
		"electron": "^39.8.10",
		"electron-builder": "^26.15.2",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vite-plugin-electron": "^0.29.1",
		"vite-plugin-electron-renderer": "^0.14.7"
	},
	"build": {
		"directories": {
			"output": "release"
		}
	},
	"main": "dist/main/main.js"
}
